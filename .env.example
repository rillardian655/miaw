# MiawBot Configuration
PORT=3456

# GitHub Webhook Secret (optional, but highly recommended for production)
GITHUB_WEBHOOK_SECRET=

# Discord Webhook URL (leave blank if not using Discord)
# Get this from: Discord Channel Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Telegram Configuration (leave blank if not using Telegram)
# Get bot token from @BotFather, get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Enable cute cat sound/reaction headers ("true" or "false")
MIAW_PERSONALITY=true
